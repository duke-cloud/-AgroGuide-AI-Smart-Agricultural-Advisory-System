# ═══════════════════════════════════════════════════════════════
#  AgroGuide AI — .gitignore
#  Django + Python ML (scikit-learn) + SQLite + Leaflet
# ═══════════════════════════════════════════════════════════════

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Virtual environments ────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Environment & secrets ───────────────────────────────────────
# Real keys (SECRET_KEY, OPENWEATHER_API_KEY) live in .env — never commit it.
# .env.example is the safe template and IS tracked.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ── Django ──────────────────────────────────────────────────────
db.sqlite3
db.sqlite3-journal
db.sqlite3-shm
db.sqlite3-wal
local_settings.py
*.log

# Generated by `collectstatic`
staticfiles/

# User uploads: farmer profile pictures + crop disease photos
media/*
!media/.gitkeep

# ── ML artefacts (regenerated by setup_and_run.sh) ──────────────
# Trained models:  python advisory/train_models.py
ml_models/*.pkl
ml_models/*.joblib
!ml_models/.gitkeep

# Synthetic training data:  python datasets/generate_datasets.py
# (the generator script itself IS tracked)
datasets/*.csv
!datasets/.gitkeep

# ── Testing & coverage ──────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
coverage.xml

# ── Build & packaging ───────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg

# ── Jupyter ─────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDE & OS ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Temp ────────────────────────────────────────────────────────
tmp/
temp/
*.tmp